@import "tailwindcss";

/* =========================================
   ACORN FONT
   ========================================= */

@font-face {
  font-family: "Acorn";
  src: url("/fonts/Acorn.woff2") format("woff2");
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
}

/* =========================================
   THEME
   ========================================= */

@theme {
  /* BLACK & WHITE THEME */
  --color-ink: #000000;
  --color-inkSoft: #171717;
  --color-paper: #FFFFFF;
  --color-paperSoft: #F7F7F7;
  --color-paperDeep: #EAEAEA;

  --color-brand: #000000;
  --color-brandBright: #FFFFFF;
  --color-brandDeep: #000000;

  --color-danger: #DC2626;

  /* ACORN TYPOGRAPHY */
  --font-display: "Acorn", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-body: "Acorn", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-mono: "Acorn", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* =========================================
   GLOBAL
   ========================================= */

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: "Acorn", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: #ffffff;
  color: #000000;
}

::selection {
  background: #800021;
  color: #ffffff;
}

a,
button {
  -webkit-tap-highlight-color: transparent;
}

/* =========================================
   BUTTONS
   ========================================= */

.btn-black,
button {
  transition: all 0.35s ease;
}

button:hover,
.btn-black:hover {
  /* Add hover styles here if needed */
}

/* =========================================
   SIGNATURE ELEMENT: MONOCHROME PULSE
   ========================================= */

.pulse-ring {
  position: absolute;
  inset: 0;
  border-radius: 9999px;
  border: 1.5px solid rgba(0, 0, 0, 0.18);
  animation: pulseOut 3s cubic-bezier(0.2, 0.6, 0.4, 1) infinite;
}

.pulse-ring.d2 {
  animation-delay: 1s;
}

.pulse-ring.d3 {
  animation-delay: 2s;
}

@keyframes pulseOut {
  0% {
    transform: scale(0.3);
    opacity: 0.8;
  }

  100% {
    transform: scale(2.4);
    opacity: 0;
  }
}

/* =========================================
   NODE ORBIT
   ========================================= */

.node-orbit {
  animation: orbit 14s linear infinite;
  transform-origin: 50% 50%;
}

@keyframes orbit {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

/* =========================================
   REDUCED MOTION
   ========================================= */

@media (prefers-reduced-motion: reduce) {
  .pulse-ring,
  .node-orbit {
    animation: none;
  }
}

/* =========================================
   SOFT MONOCHROME GRAIN
   ========================================= */

.grain {
  background-image:
    radial-gradient(
      circle at 1px 1px,
      rgba(0, 0, 0, 0.05) 1px,
      transparent 0
    );
  background-size: 22px 22px;
}

/* =========================================
   UNIQUE CARD HOVER EFFECT
   ========================================= */

.card-hover {
  position: relative;
  overflow: hidden;
  transition:
    transform 0.35s ease,
    box-shadow 0.35s ease,
    border-color 0.35s ease;
}

.card-hover::before {
  content: "";
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      135deg,
      transparent 0%,
      rgba(255, 255, 255, 0.75) 45%,
      transparent 100%
    );

  transform: translateX(-150%);
  transition: transform 0.7s ease;
  pointer-events: none;
}

.card-hover:hover {
  transform: translateY(-8px) scale(1.02);

  box-shadow:
    0 20px 40px rgba(0, 0, 0, 0.12),
    0 0 0 1px rgba(0, 0, 0, 0.08);
}

.card-hover:hover::before {
  transform: translateX(150%);
}

/* =========================================
   FAQ
   ========================================= */

details > summary {
  list-style: none;
}

details > summary::-webkit-details-marker {
  display: none;
}

details[open] .chev {
  transform: rotate(45deg);
}

/* =========================================
   PLAN SELECTOR
   ========================================= */

.plan-card {
  transition:
    border-color 0.2s ease,
    background-color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.plan-card:hover {
  border-color: #000;
  transform: translateY(-3px);
}

.plan-radio:checked + .plan-card {
  border-color: #000000;
  background-color: #f7f7f7;

  box-shadow:
    0 0 0 2px rgba(0, 0, 0, 0.08),
    0 10px 30px rgba(0, 0, 0, 0.08);
}

.plan-radio:checked + .plan-card .plan-dot {
  background-color: #000000;
  border-color: #000000;
}

.plan-radio:checked + .plan-card .plan-dot::after {
  transform: scale(1);
}

.plan-radio:focus-visible + .plan-card {
  outline: 2px solid #000000;
  outline-offset: 2px;
}

.plan-dot {
  position: relative;
}

.plan-dot::after {
  content: "";

  position: absolute;
  inset: 3px;

  border-radius: 9999px;
  background: #ffffff;

  transform: scale(0);
  transition: transform 0.15s ease;
}

/* =========================================
   FADE ANIMATION
   ========================================= */

.fade-in {
  animation: fadeIn 0.35s ease both;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================
   PREMIUM MONOCHROME HOVER
   ========================================= */

.hover-glow:hover {
  box-shadow:
    0 0 0 1px rgba(0, 0, 0, 0.08),
    0 25px 50px rgba(0, 0, 0, 0.15);
}
